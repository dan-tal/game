server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # admin.html accesibil si fara extensie, ca link mai scurt
    location = /admin {
        try_files /admin.html =404;
    }

    # TOATE fisierele (index.html, version.js, dar si games/*.js, style.css,
    # config.js, exercises.js...) trebuie sa fie mereu proaspete. Inainte doar
    # index.html/version.js aveau asta — restul (mai ales games/*.js) puteau
    # ramane cache-uite vechi in telefon dupa un deploy chiar daca index.html
    # era deja nou, asa ca un fisier nou (ex: car-game.js, care acum apeleaza
    # GameShared.bindHoldButton) putea rula alaturi de un game-shared.js VECHI
    # din cache, fara acea functie — joc stricat/butoane lipsa, fara nicio
    # eroare vizibila pentru copil, doar pentru cine deschide consola.
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-App-Version "__VERSION__" always;
        try_files $uri $uri/ =404;
    }
}
